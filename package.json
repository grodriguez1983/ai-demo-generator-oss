{
  "name": "ai-demo-generator",
  "version": "1.0.0",
  "description": "Turn a declarative YAML flow into a narrated product-demo video: record with Playwright, script with an LLM, voice with TTS, render with ffmpeg.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "demo": "tsx src/index.ts",
    "record-only": "tsx src/index.ts --skip-script --skip-voice --skip-render",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "openai": "^4.78.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
