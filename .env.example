# ── Target app ──────────────────────────────────────────────────────
# Base URL of the app (or public site) to record. Must be reachable.
# The bundled example records against a public demo site:
BASE_URL=https://demo.playwright.dev

# Optional: credentials for the built-in login step. Only used by demos that
# log in (i.e. NOT skip_login). The example skips login, so these are ignored.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo

# Optional: command that puts the app into a known state before recording.
# Left empty = no seed. Example: SEED_COMMAND="npm --prefix ../my-app run db:seed"
SEED_COMMAND=
# Working directory for SEED_COMMAND (defaults to this repo root).
SEED_CWD=

# ── Script generation (LLM) ─────────────────────────────────────────
# Required: an OpenAI key — the LLM writes the narration from each segment's
# narration_hint. (Verbatim screen decks make no LLM call, but a value must
# still be present for validation.)
OPENAI_API_KEY=sk-...

# ── Voice (TTS) — CHOOSE ONE PROVIDER ────────────────────────────────
# Two ways to generate the voice. An agent setting this up should ASK the user
# which one (do not assume):
#
#   A) ElevenLabs  → BEST quality: natural, expressive. Needs an ElevenLabs
#      account. Set TTS_PROVIDER=elevenlabs and fill Option A below
#      (ELEVENLABS_API_KEY + a voice id).
#   B) OpenAI TTS  → CHEAPER, no second account (reuses OPENAI_API_KEY above),
#      but LOWER quality — the voice sounds more robotic. Set
#      TTS_PROVIDER=openai. (Warn the user about the quality drop.)
#
TTS_PROVIDER=elevenlabs

# ── Option A — ElevenLabs (used when TTS_PROVIDER=elevenlabs) ─────────
# Key: elevenlabs.io → Profile → API key.
ELEVENLABS_API_KEY=
# Voice id: elevenlabs.io → Voices → pick a voice → its id is in the URL.
# Empty = "Rachel", a premade voice on every account. Premade multilingual ids:
#   Rachel 21m00Tcm4TlvDq8ikWAM · Adam pNInz6obpgDQGcFmaJgB · Antoni ErXwobaYiN019PkySvjV
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_multilingual_v2 (quality) or eleven_turbo_v2_5 (faster/cheaper).
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Option B — OpenAI TTS (used when TTS_PROVIDER=openai) ─────────────
# Cheaper and needs no second account (reuses OPENAI_API_KEY). Lower quality.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# ── Video defaults (each demo YAML can override) ────────────────────
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
GIF_FPS=10
GIF_WIDTH=640
