# ── Target app ──────────────────────────────────────────────────────
# Base URL of the app (or public site) to record. Must be reachable.
# The bundled example records against a public demo site:
BASE_URL=https://demo.playwright.dev

# Optional: credentials for the built-in login step. Only used by demos that
# log in (i.e. NOT skip_login). The example skips login, so these are ignored.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo

# Optional: command that puts the app into a known state before recording.
# Left empty = no seed. Example: SEED_COMMAND="npm --prefix ../my-app run db:seed"
SEED_COMMAND=
# Working directory for SEED_COMMAND (defaults to this repo root).
SEED_CWD=

# ── Script generation (LLM) ─────────────────────────────────────────
# Required: writes the narration from each segment's narration_hint.
OPENAI_API_KEY=sk-...

# ── Voice (TTS) ─────────────────────────────────────────────────────
# "openai" (uses OPENAI_API_KEY) or "elevenlabs".
TTS_PROVIDER=openai
# OpenAI TTS:
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# ElevenLabs (only if TTS_PROVIDER=elevenlabs):
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Video defaults (each demo YAML can override) ────────────────────
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
GIF_FPS=10
GIF_WIDTH=640
